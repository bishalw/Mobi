# Build outputs
target/
build/
dist/

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/

# Maven wrapper jars
.mvn/wrapper/maven-wrapper.jar

# IDE files
.idea/
*.iws
*.iml
*.ipr
.classpath
.project
.settings/

# OS files
.DS_Store

# Logs and runtime files
*.log
*.pid

# Local environment files with secrets
.env
.env.local
.env.*.local

# Local configuration overrides with credentials
config-repo/*.local.properties

# Helm values rendered from Terraform outputs by scripts/render-values.sh.
# These carry real endpoints and registry paths, and are cheap to recreate, so
# Terraform state stays the single source of truth.
helm/mobi/values-*.generated.yaml

# Local backups
*.git-backup/

# deploy.sh: set while a wiped local database still needs re-seeding
.mobi-reseed-pending
