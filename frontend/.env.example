# Where `npm run dev` proxies /auth, /productapi, /inventoryapi, /orderapi,
# /paymentapi and /procurementapi. Copy to .env.local to change it.
#   kind cluster (Envoy Gateway on port 80):  http://localhost   (the default)
#   api-gateway run directly from the IDE:    http://localhost:8080
VITE_API_TARGET=http://localhost
