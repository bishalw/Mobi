# Copy this file to .env.local for local development and replace the placeholder values.
# Never commit .env.local or real secret values.

AUTH_DB_NAME=authdb
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=replace-with-local-auth-db-password

PRODUCT_DB_NAME=productdb
PRODUCT_DB_USERNAME=product_user
PRODUCT_DB_PASSWORD=replace-with-local-product-db-password

INVENTORY_DB_NAME=inventorydb
INVENTORY_DB_USERNAME=inventory_user
INVENTORY_DB_PASSWORD=replace-with-local-inventory-db-password

ORDER_DB_NAME=orderdb
ORDER_DB_USERNAME=order_user
ORDER_DB_PASSWORD=replace-with-local-order-db-password

PAYMENT_DB_NAME=paymentdb
PAYMENT_DB_USERNAME=payment_user
PAYMENT_DB_PASSWORD=replace-with-local-payment-db-password

PROCUREMENT_DB_NAME=procurementdb
PROCUREMENT_DB_USERNAME=procurement_user
PROCUREMENT_DB_PASSWORD=replace-with-local-procurement-db-password

NOTIFICATION_DB_NAME=notificationdb
NOTIFICATION_DB_USERNAME=notification_user
NOTIFICATION_DB_PASSWORD=replace-with-local-notification-db-password

# RS256 token-signing key, held only by auth-service (PKCS#8, one-line base64 DER or PEM).
# scripts/deploy.sh local generates one into .env.local if this is empty. By hand:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64
# Left empty when running auth-service directly, it generates a temporary key per start.
JWT_PRIVATE_KEY=
JWT_EXPIRATION_MS=900000
# Where services find the issuer's public keys (direct-run defaults shown).
JWT_ISSUER=http://localhost:8082
JWT_JWK_SET_URI=http://localhost:8082/.well-known/jwks.json
# order-service's client secret for the client-credentials grant; auth-service and
# order-service must agree. scripts/deploy.sh local generates it into .env.local if
# empty; by hand: openssl rand -hex 24
ORDER_SERVICE_CLIENT_SECRET=
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-local-admin-password
# Demo warehouse and supplier logins (supplier is linked to supplier 1, "Mobi Distribution").
WAREHOUSE_BOOTSTRAP_ENABLED=true
WAREHOUSE_BOOTSTRAP_USERNAME=warehouse
WAREHOUSE_BOOTSTRAP_PASSWORD=warehousepass
SUPPLIER_BOOTSTRAP_ENABLED=true
SUPPLIER_BOOTSTRAP_USERNAME=supplier
SUPPLIER_BOOTSTRAP_PASSWORD=supplierpass

# Optional direct-run overrides. Docker Compose sets container database URLs in docker-compose.yml.
AUTH_DB_URL=jdbc:mysql://localhost:3306/authdb
PRODUCT_DB_URL=jdbc:mysql://localhost:3306/productdb
INVENTORY_DB_URL=jdbc:mysql://localhost:3306/inventorydb
ORDER_DB_URL=jdbc:mysql://localhost:3306/orderdb
AUTH_JPA_DDL_AUTO=validate
PRODUCT_JPA_DDL_AUTO=validate
INVENTORY_JPA_DDL_AUTO=validate
ORDER_JPA_DDL_AUTO=validate
AUTH_JPA_SHOW_SQL=false
PRODUCT_JPA_SHOW_SQL=false
INVENTORY_JPA_SHOW_SQL=false
ORDER_JPA_SHOW_SQL=false

ORDER_IDEMPOTENCY_TTL_SECONDS=86400
ORDER_EVENTS_TOPIC=order-events

MYSQL_ROOT_PASSWORD=replace-with-local-mysql-root-password
